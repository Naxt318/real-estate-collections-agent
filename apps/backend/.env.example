# Backend settings. Copy to apps/backend/.env and fill in the URLs. Never commit .env.
# The app connects as app_user; migrations connect as app_owner (see docker/postgres/init).
NODE_ENV=development
PORT=3001
DATABASE_URL=
MIGRATION_DATABASE_URL=
TEST_DATABASE_URL=
TEST_MIGRATION_DATABASE_URL=
ALLOW_DEV_TENANT_HEADER=true
